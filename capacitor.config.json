{
  "appId": "com.egzey.mytubeboss",
  "appName": "MyTube Boss",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": false,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "CapacitorCookies": {
      "enabled": true
    }
  },
  "backgroundColor": "#0a0a0c"
}